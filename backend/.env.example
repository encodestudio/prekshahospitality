SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database
DB_NAME=preksha_hospitality
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# Email — Gmail SMTP (recommended for development)
# EMAIL_HOST_USER: your Gmail or Google Workspace address
# EMAIL_HOST_PASSWORD: 16-char App Password (NOT your login password)
#   Requires 2-Step Verification. Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=contact@yourdomain.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=contact@yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com
# Copied on every booking-request confirmation and status-update email, alongside the guest
BOOKINGS_TEAM_EMAIL=bookings@yourdomain.com

# Email — SendGrid (production alternative, leave blank if using Gmail above)
SENDGRID_API_KEY=

# ICS WhatsApp Business API (WABA notifications)
# Credentials provided when the ICS account is created (https://ngui.sendmsg.in).
# ICS_WHATSAPP_FROM is your registered WABA number, no "+", e.g. 918147745XXX
# Templates (booking_request, booking_confirmed, booking_cancelled) must be
# created via the ICS dashboard/API and approved by Meta before they'll work —
# see "ICS WABA API Documentation.pdf". The template NAME is sent directly to
# ICS's API (per their support), so no separate template-id setting is needed.
ICS_WHATSAPP_USER=your_ics_username
ICS_WHATSAPP_PASS=your_ics_password
ICS_WHATSAPP_FROM=918147745XXX
# Booking-request-received / booking-confirmed templates carrying the policy content.
# These are separate templates from the originals (not in-place edits), so the names
# are configurable rather than hardcoded. booking_cancelled is unaffected.
ICS_WHATSAPP_REQUEST_TEMPLATE=booking_request_alt
ICS_WHATSAPP_CONFIRMED_TEMPLATE=booking_confirmed_alt
# Name of a separately approved Document-header template used to deliver the
# booking ticket PDF over WhatsApp (see bookings/tasks.py send_booking_ticket_whatsapp).
# Must be created + Meta-approved via the ICS dashboard before this will send.
ICS_WHATSAPP_TICKET_TEMPLATE=booking_ticket

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Frontend URL
FRONTEND_URL=http://localhost:3000
# Public base URL of THIS backend (no trailing slash) — used to build the
# booking-ticket PDF link handed to WhatsApp/ICS so it can fetch the document.
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
